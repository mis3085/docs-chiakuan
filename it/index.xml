        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#avanzare-nello-sviluppo-e-progettazione-di-stampi-per-una-produzione-di-precisione&#34; aria-label=&#34;Ancora&#34;&gt;#&lt;/a&gt;
