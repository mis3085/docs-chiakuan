    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e9%87%91%e5%9e%8b%e9%96%8b%e7%99%ba%e3%81%a8%e8%a8%ad%e8%a8%88%e3%82%92%e6%94%af%e3%81%88%e3%82%8b%e5%85%88%e9%80%b2%e3%83%84%e3%83%bc%e3%83%ab&#34; aria-label=&#34;アンカー&#34;&gt;#&lt;/a&gt;
