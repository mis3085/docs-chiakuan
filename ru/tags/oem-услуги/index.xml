        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%d0%ba%d0%be%d0%bd%d1%82%d0%b0%d0%ba%d1%82%d0%bd%d0%b0%d1%8f-%d0%b8%d0%bd%d1%84%d0%be%d1%80%d0%bc%d0%b0%d1%86%d0%b8%d1%8f&#34; aria-label=&#34;Якорь&#34;&gt;#&lt;/a&gt;
    &lt;/span&gt;        
    
&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Электронная почта:&lt;/strong&gt; &lt;a
  href=&#34;mailto:info@chiakuan.com.tw&#34;&gt;info@chiakuan.com.tw&lt;/a&gt;
&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Адрес:&lt;/strong&gt; &lt;a
  href=&#34;https://maps.app.goo.gl/7hUMsbEfg9avEUaR6&#34;
    target=&#34;_blank&#34;
  &gt;№ 939, дорога Жэнь Ай, посёлок Чжунань, уезд Мяоли, Тайвань&lt;/a&gt;
