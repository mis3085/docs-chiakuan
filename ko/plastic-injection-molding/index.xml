        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%ed%98%84%eb%8c%80-%ec%a0%9c%ec%a1%b0%ec%97%90%ec%84%9c-%ed%94%8c%eb%9d%bc%ec%8a%a4%ed%8b%b1-%ec%82%ac%ec%b6%9c-%ec%84%b1%ed%98%95%ec%9d%98-%eb%8b%a4%ec%9e%ac%eb%8b%a4%eb%8a%a5%ec%84%b1&#34; aria-label=&#34;앵커&#34;&gt;#&lt;/a&gt;
